---
import '../styles/index.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/merriweather/400.css';
import '@fontsource/merriweather/400-italic.css';
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { ClientRouter } from 'astro:transitions';

const {
  title = "Swastick_",
  description = "Portfolio of Swastick Ghosh."
} = Astro.props;

const siteUrl = "https://silvex.pages.dev";
const previewImage = `${siteUrl}/preview-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />
    
    <!-- ------ CRITICAL FONT PRELOAD ------ -->
    <link rel="preload" href="/_astro/jetbrains-mono-latin-wght-normal.B9CIFXIH.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- ------ Icons ------ -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- ------ Verification ------ -->
    <meta name="google-site-verification" content="WM6Xef65Rl-MYswNtTRKnzvJYAZ2-43BiiUcuWeSbG8" />
    
    <!-- ------ SEO ------ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />

    <!-- ------ Open Graph ------ -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:alt" content="Swastick_ | Python Developer & Problem Solver" />
    <meta property="og:site_name" content="Swastick_" />

    <!-- ------ Twitter / X ------ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content="Swastick_ | Python Developer & Problem Solver" />

    <ClientRouter />

    <!-- ------ Speculation Rules API (Restored) ------ -->
    <script type="speculationrules">
      {
        "prerender": [
          {
            "source": "document",
            "where": {
              "and": [
                { "href_matches": "/*" }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    <!-- ------ Global Scripts ------ -->
    <script is:inline>
      // ------ Easter Eggs ------
      function initEasterEggs() {
        if (!window.hasEasterEggs) {
          window.hasEasterEggs = true;

          setTimeout(() => {
            console.info(
              "%c ❯ Hello Visitor. \n\n%c Ah, looking under the hood? I respect that.\n If you're a recruiter or fellow developer, let's skip the queue.\n\n ↗ Email me directly: swastickghosh2010@gmail.com\n\n",
              "color: #6fe3cf; font-size: 18px; font-weight: bold; font-family: monospace;",
              "color: #a1b3c9; font-size: 13px; font-family: monospace; line-height: 1.6;"
            );
          }, 1500);

          function triggerRetroMode() {
            if (sessionStorage.getItem("retroMode") === "true") return; 
            
            sessionStorage.setItem("retroMode", "true");
            document.documentElement.classList.add("retro-mode");
            
            console.info("%c ❯ REST 30", "color: #ff0000; font-size: 14px; font-weight: bold;");
            alert("30 Lives!");
            
            window.open("https://www.youtube.com/watch?v=dQw4w9WgXcQ", "_blank");
          }

          const konami = ['arrowup', 'arrowup', 'arrowdown', 'arrowdown', 'arrowleft', 'arrowright', 'arrowleft', 'arrowright', 'b', 'a'];
          let kIdx = 0;
          
          document.addEventListener('keydown', (e) => {
            const key = e.key.toLowerCase();
            if (key === konami[kIdx]) {
              kIdx++;
              if (kIdx === konami.length) {
                kIdx = 0;
                triggerRetroMode();
              }
            } else {
              kIdx = (key === konami[0]) ? 1 : 0;
            }
          });

          let tapCount = 0;
          let tapTimer;
          document.addEventListener('click', (e) => {
            const brandLink = e.target.closest('.brand');
            
            if (brandLink) {
              if (window.location.pathname === '/' || window.location.pathname === '') {
                e.preventDefault();
                window.scrollTo({ top: 0, behavior: 'smooth' }); 
              }

              tapCount++;
              clearTimeout(tapTimer);
              tapTimer = setTimeout(() => tapCount = 0, 500);
              
              if (tapCount === 7) {
                tapCount = 0;
                triggerRetroMode();
              }
            }
          });
        }
      }

      function restoreTheme() {
        if (sessionStorage.getItem("retroMode") === "true") {
          document.documentElement.classList.add("retro-mode");
          return; 
        }

        const savedTheme = localStorage.getItem("theme") || "blue";
        const root = document.documentElement;

        if (savedTheme === "purple") {
          root.style.setProperty("--accent", "#dd91f0");
          root.style.setProperty("--mint", "#f39b9d");
        } else if (savedTheme === "green") {
          root.style.setProperty("--accent", "#59d99f");
          root.style.setProperty("--mint", "#f5d56f");
        } else {
          root.style.removeProperty("--accent");
          root.style.removeProperty("--mint");
        }
      }
      
      function initPolish() {
        const isDesktop = window.matchMedia("(pointer: fine)").matches;

        <!if (!isDesktop) return;

        document.body.classList.add('has-custom-cursor');
        if (window.__polishInitialized) return;
        window.__polishInitialized = true;

        let activeMagnetic = null;
        let magneticRect = null;
        let pointerX = 0;
        let pointerY = 0;
        let frameId = 0;

        const renderPointer = () => {
          frameId = 0;

          document.documentElement.style.setProperty('--mouse-x', `${pointerX}px`);
          document.documentElement.style.setProperty('--mouse-y', `${pointerY}px`);

          if (activeMagnetic && magneticRect) {
            const x = (pointerX - magneticRect.left - magneticRect.width / 2) * 0.3;
            const y = (pointerY - magneticRect.top - magneticRect.height / 2) * 0.3;
            activeMagnetic.style.transform = `translate3d(${x}px, ${y}px, 0)`;
          }
        };

        document.addEventListener('pointermove', (e) => {
          pointerX = e.clientX;
          pointerY = e.clientY;

          if (!frameId) frameId = requestAnimationFrame(renderPointer);
        }, { passive: true });

        document.addEventListener('pointerover', (e) => {
          const target = e.target instanceof Element ? e.target : null;
          if (!target) return;

          const interactive = target.closest('a, button, .magnetic');
          if (interactive) {
            document.getElementById('custom-cursor')?.classList.add('hovering');
          }

          const magnetic = target.closest('.magnetic');
          if (magnetic && !(e.relatedTarget instanceof Node && magnetic.contains(e.relatedTarget))) {
            activeMagnetic = magnetic;
            magneticRect = magnetic.getBoundingClientRect();
          }
        }, { passive: true });

        document.addEventListener('pointerout', (e) => {
          const target = e.target instanceof Element ? e.target : null;
          const related = e.relatedTarget instanceof Node ? e.relatedTarget : null;

          if (target?.closest('a, button, .magnetic') &&
              !(related instanceof Element && target.closest('a, button, .magnetic')?.contains(related))) {
            document.getElementById('custom-cursor')?.classList.remove('hovering');
          }

          if (activeMagnetic && !activeMagnetic.contains(related)) {
            activeMagnetic.style.transform = 'translate3d(0, 0, 0)';
            activeMagnetic = null;
            magneticRect = null;
          }
        }, { passive: true });

        document.addEventListener('click', (e) => {
          const target = e.target instanceof Element ? e.target.closest('.email-copy') : null;
          if (!target) return;

          e.preventDefault();
          navigator.clipboard.writeText("swastickghosh2010@gmail.com");

          const originalHTML = target.innerHTML;
          target.innerHTML = "Copied! ✓";
          target.style.color = "var(--mint)";

          setTimeout(() => {
            target.innerHTML = originalHTML;
            target.style.color = "";
          }, 2000);
        });
      }

      restoreTheme();
      initEasterEggs();
      
      document.addEventListener("astro:page-load", () => {
        restoreTheme();
        initPolish();
      });
    </script>
  </head>

  <body>
    <!-- ------ Custom Cursor ------ -->
    <div id="custom-cursor"></div>
    
    <!-- ------ Application Root ------ -->
    <div class="site-shell" id="top">
      <Header pathname={Astro.url.pathname} client:idle />
      <main>
        <slot />
      </main>
      <Footer client:visible />
    </div>
  </body>
</html>

<style is:global>
  /* ------ Drastic Easter Egg Overrides (Contra Theme) ------ */
  html.retro-mode body, 
  html.retro-mode .site-shell {
    background: #000 !important;
    background-image: none !important;
  }
  
  html.retro-mode {
    --accent: #ff0000 !important; 
    --mint: #0044ff !important;   
  }
  
  /* Force all standard text to Explosive Orange */
  html.retro-mode p, 
  html.retro-mode h1, 
  html.retro-mode h2, 
  html.retro-mode h3, 
  html.retro-mode span:not(.brand-prompt):not(.brand-cursor):not(.status-dot), 
  html.retro-mode div,
  html.retro-mode a {
    color: #ff4500 !important; 
    text-shadow: 0 0 6px rgba(255, 69, 0, 0.4) !important;
  }
  
  html.retro-mode .site-header {
    background: #000 !important;
    border-bottom-color: #0044ff !important;
  }
  
  /* Force cards and code blocks to match */
  html.retro-mode .project-card,
  html.retro-mode .code-window,
  html.retro-mode .cli-terminal {
    background: #050505 !important;
    border-color: #ff0000 !important;
    box-shadow: 0 0 15px rgba(255, 0, 0, 0.2) !important;
  }
  
  html.retro-mode .progress-bar {
    background: linear-gradient(90deg, #ff0000, #0044ff) !important;
  }
</style>
