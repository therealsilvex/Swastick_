---
import '../styles/index.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/merriweather/400.css';
import '@fontsource/merriweather/400-italic.css';
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { ClientRouter } from 'astro:transitions';

const {
  title = "Swastick_ | Portfolio",
  description = "Portfolio of Swastick Ghosh."
} = Astro.props;

const siteUrl = "https://silvex.pages.dev";
const previewImage = `${siteUrl}/preview-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ------ Icons ------ -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- ------ Verification ------ -->
    <meta name="google-site-verification" content="WM6Xef65Rl-MYswNtTRKnzvJYAZ2-43BiiUcuWeSbG8" />
    
    <!-- ------ SEO ------ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />

    <!-- ------ Open Graph ------ -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:alt" content="Swastick_ | Python Developer & Problem Solver" />
    <meta property="og:site_name" content="Swastick_" />

    <!-- ------ Twitter / X ------ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content="Swastick_ | Python Developer & Problem Solver" />

    <ClientRouter />

    <!-- ------ Global Scripts ------ -->
    <script is:inline>
      // ------ Easter Eggs ------
      function initEasterEggs() {
        if (!window.hasEasterEggs) {
          window.hasEasterEggs = true;

          // 1. Added a 1.5-second delay so mobile consoles have time to open and catch the message
          setTimeout(() => {
            console.info(
              "%c ❯ Hello Visitor. \n\n%c Ah, looking under the hood? I respect that.\n If you're a recruiter or fellow developer, let's skip the queue.\n\n ↗ Email me directly: swastickghosh2010@gmail.com\n\n",
              "color: #6fe3cf; font-size: 18px; font-weight: bold; font-family: monospace;",
              "color: #a1b3c9; font-size: 13px; font-family: monospace; line-height: 1.6;"
            );
          }, 1500);

          function triggerMatrixMode() {
            const root = document.documentElement;
            root.style.setProperty("--accent", "#00ff41");
            root.style.setProperty("--mint", "#00ff41");
            document.body.style.background = "#000";
            
            console.info("%c ❯ System override engaged.", "color: #00ff41; font-size: 14px; font-weight: bold;");
            alert("Sequence accepted.");
            window.open("https://www.youtube.com/watch?v=dQw4w9WgXcQ", "_blank");
          }

          // 2. Keyboard Konami Code (Forced Lowercase to fix Mobile Auto-Caps)
          const konami = ['arrowup', 'arrowup', 'arrowdown', 'arrowdown', 'arrowleft', 'arrowright', 'arrowleft', 'arrowright', 'b', 'a'];
          let kIdx = 0;
          
          document.addEventListener('keydown', (e) => {
            const key = e.key.toLowerCase(); // Forces "B" to become "b"
            if (key === konami[kIdx]) {
              kIdx++;
              if (kIdx === konami.length) {
                kIdx = 0;
                triggerMatrixMode();
              }
            } else {
              kIdx = (key === konami[0]) ? 1 : 0; // Smart reset
            }
          });

          // 3. Mobile Easter Egg Bypass: Rapidly tap the logo 7 times
          let tapCount = 0;
          let tapTimer;
          document.addEventListener('click', (e) => {
            if (e.target.closest('.brand')) {
              tapCount++;
              clearTimeout(tapTimer);
              tapTimer = setTimeout(() => tapCount = 0, 500); // Reset count if you pause tapping
              
              if (tapCount === 7) {
                tapCount = 0;
                triggerMatrixMode();
              }
            }
          });
        }
      }

      // ------ Theme Initialization ------
      function restoreTheme() {
        const savedTheme = localStorage.getItem("theme") || "blue";
        const root = document.documentElement;

        if (savedTheme === "purple") {
          root.style.setProperty("--accent", "#dd91f0");
          root.style.setProperty("--mint", "#f39b9d");
        } else if (savedTheme === "green") {
          root.style.setProperty("--accent", "#59d99f");
          root.style.setProperty("--mint", "#f5d56f");
        } else {
          root.style.removeProperty("--accent");
          root.style.removeProperty("--mint");
        }
      }
      
      // ------ UI Engine ------
      function initPolish() {
        const cursor = document.getElementById('custom-cursor');
        const isDesktop = window.matchMedia("(pointer: fine)").matches;

        if (isDesktop) {
          document.body.classList.add('has-custom-cursor');

          document.addEventListener('mousemove', (e) => {
            document.documentElement.style.setProperty('--mouse-x', `${e.clientX}px`);
            document.documentElement.style.setProperty('--mouse-y', `${e.clientY}px`);
            if (cursor) {
              cursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
            }
          }, { passive: true });

          document.querySelectorAll('a, button, .magnetic').forEach(el => {
            el.addEventListener('mouseenter', () => cursor?.classList.add('hovering'));
            el.addEventListener('mouseleave', () => cursor?.classList.remove('hovering'));
          });

          document.querySelectorAll('.magnetic').forEach(btn => {
            let rect = null;

            btn.addEventListener('mouseenter', () => {
              rect = btn.getBoundingClientRect();
            });

            btn.addEventListener('mousemove', (e) => {
              if (!rect) rect = btn.getBoundingClientRect();
              const x = (e.clientX - rect.left - rect.width / 2) * 0.3;
              const y = (e.clientY - rect.top - rect.height / 2) * 0.3;
              btn.style.transform = `translate3d(${x}px, ${y}px, 0)`;
            }, { passive: true });

            btn.addEventListener('mouseleave', () => {
              rect = null;
              btn.style.transform = 'translate3d(0, 0, 0)';
            });
          });
        }

        document.querySelectorAll('.email-copy').forEach(el => {
          el.addEventListener('click', (e) => {
            e.preventDefault();
            navigator.clipboard.writeText("swastickghosh2010@gmail.com");
            const originalHTML = el.innerHTML;
            el.innerHTML = "Copied! ✓";
            el.style.color = "var(--mint)";
            setTimeout(() => {
              el.innerHTML = originalHTML;
              el.style.color = "";
            }, 2000);
          });
        });
      }

      restoreTheme();
      initEasterEggs();
      
      document.addEventListener("astro:page-load", () => {
        restoreTheme();
        initPolish();
      });
    </script>
  </head>

  <body>
    <!-- ------ Custom Cursor ------ -->
    <div id="custom-cursor"></div>
    
    <!-- ------ Application Root ------ -->
    <div class="site-shell" id="top">
      <Header pathname={Astro.url.pathname} client:load />
      <main>
        <slot />
      </main>
      <Footer client:visible />
    </div>
  </body>
</html>
