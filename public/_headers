# --- 1. GLOBAL SECURITY HEADERS ---
# Applies to every single page on the site
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# --- 2. ASTRO ASSET CACHING ---
# Astro hashes these files, so they never change. Cache them for 1 year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# --- 3. STATIC MEDIA CACHING ---
# Cache fonts and images for 1 year to improve Lighthouse scores
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable

# --- 4. FAVICON CACHING ---
/favicon.ico
  Cache-Control: public, max-age=86400
